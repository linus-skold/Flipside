package-as: Flipside

ignore:
  - Tests
  - docs
  - ScanTest
  - ScanTest.lua*
  - lua51
  - .claude
  - .github
  - .busted
  - .luacheckrc
  - .gitignore
  - CLAUDE.md
  - README.md
  - "*.png"
  - .lua
  - .luarocks
  - .release

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

package-as: Flipside

move-folders:
  Flipside/Flipside_Ledger: Flipside_Ledger

ignore:
  - Tests
  - docs
  - ScanTest
  - ScanTest.lua*
  - lua51
  - .claude
  - .github
  - .busted
  - .luacheckrc
  - .gitignore
  - CLAUDE.md
  - README.md
  - "*.png"
  - .lua
  - .luarocks
  - .release
  - scripts

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown
